{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SAS: Run current program",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/scripts/invoke-sas.ps1",
        "-SysIn", "${file}"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy", "Bypass",
          "-File", "${workspaceFolder}/scripts/invoke-sas.ps1",
          "-SysIn", "${file}"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Python: Run current pipeline (uv)",
      "type": "shell",
      "command": "uv",
      "args": ["run", "python", "${file}"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "R: Run current script",
      "type": "shell",
      "command": "Rscript",
      "args": ["${file}"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Project: Validate Integrity",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "python",
        "${workspaceFolder}/scripts/validate-project.py",
        "--project-dir",
        "${workspaceFolder}"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Quarto: Render Static Report",
      "type": "shell",
      "command": "quarto",
      "args": ["render", "${workspaceFolder}/reports/quarto/summary.qmd"],
      "group": "build"
    },
    {
      "label": "Quarto: Render Interactive Report",
      "type": "shell",
      "command": "python",
      "args": [
        "-c",
        "import shutil, subprocess, pathlib; subprocess.run(['quarto', 'render', 'reports/quarto/interactive_summary.qmd'], check=True); src = pathlib.Path('reports/quarto/interactive_summary.html'); dst = pathlib.Path('outputs/private/interactive_summary.html'); dst.parent.mkdir(parents=True, exist_ok=True); shutil.move(str(src), str(dst)) if src.exists() else None"
      ],
      "group": "build"
    },
    {
      "label": "Quarto: Preview Local Report (127.0.0.1)",
      "type": "shell",
      "command": "python",
      "args": ["-m", "http.server", "8000", "--bind", "127.0.0.1", "--directory", "${workspaceFolder}/outputs/private"],
      "isBackground": true
    },
    {
      "label": "Slidev: Start Dev Server",
      "type": "shell",
      "command": "pnpm",
      "args": ["slidev", "${workspaceFolder}/reports/slidev/slides.md"],
      "isBackground": true
    }
  ]
}
