{
  "files.encoding": "utf8",
  "files.associations": {
    "*.sas": "sas",
    "*.qmd": "quarto",
    "PROJECT.yml": "yaml",
    "release-manifest.yml": "yaml"
  },
  "[sas]": {
    "files.encoding": "shiftjis"
  },
  "editor.formatOnSave": true,
  "files.autoGuessEncoding": false,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "files.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.run": false
  }
}
