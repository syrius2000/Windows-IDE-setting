{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OcrEnvelopeSchema",
  "description": "Disease-agnostic schema for OCR extracted text, bounding boxes, confidence, and audit metadata",
  "type": "object",
  "required": [
    "document_id",
    "source_file_hash",
    "pages",
    "engine",
    "created_at",
    "audit"
  ],
  "additionalProperties": false,
  "properties": {
    "document_id": {
      "type": "string",
      "description": "De-identified management document ID (must NOT contain patient personal identifiers)"
    },
    "source_file_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hash of original PDF document"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 execution timestamp"
    },
    "engine": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "enum": ["apple-vision", "tesseract", "local-vlm", "hybrid"],
          "description": "Primary OCR engine used"
        },
        "version": {
          "type": "string",
          "description": "Engine/framework version"
        },
        "vlm_model": {
          "type": ["string", "null"],
          "description": "Local VLM model name if invoked"
        },
        "llm_structuring_model": {
          "type": ["string", "null"],
          "description": "Local LLM model used for JSON structuring (e.g. gpt-oss-120b)"
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page_number", "blocks"],
        "additionalProperties": false,
        "properties": {
          "page_number": {
            "type": "integer",
            "minimum": 1
          },
          "dimensions": {
            "type": "object",
            "properties": {
              "width": { "type": "number" },
              "height": { "type": "number" }
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "confidence", "bbox"],
              "additionalProperties": false,
              "properties": {
                "text": { "type": "string" },
                "confidence": {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                "bbox": {
                  "type": "object",
                  "required": ["x", "y", "width", "height"],
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" },
                    "width": { "type": "number" },
                    "height": { "type": "number" }
                  }
                },
                "routing": {
                  "type": "string",
                  "enum": ["vision-high-confidence", "vlm-fallback", "manual-queue"],
                  "description": "Extraction route applied"
                }
              }
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "required": ["pipeline_version", "human_review_status"],
      "additionalProperties": false,
      "properties": {
        "pipeline_version": { "type": "string" },
        "git_commit": { "type": ["string", "null"] },
        "human_review_status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "modified"]
        },
        "reviewed_by": { "type": ["string", "null"] },
        "reviewed_at": { "type": ["string", "null"] },
        "review_notes": { "type": "string" }
      }
    }
  }
}
